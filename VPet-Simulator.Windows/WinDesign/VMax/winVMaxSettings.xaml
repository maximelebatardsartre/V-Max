<Window x:Class="VPet_Simulator.Windows.winVMaxSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ll="clr-namespace:LinePutScript.Localization.WPF;assembly=LinePutScript.Localization.WPF"
        Title="{ll:Str Paramètres de V-Max}" Width="980" Height="680" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource VMaxWindowFallback}" Foreground="{DynamicResource PrimaryText}"
        FontFamily="{DynamicResource MainFont}" FontSize="14" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing" Loaded="Window_Loaded" KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource VMaxScrollBar}" />
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0"
                UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.98" ScaleY="0.98" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Barre de titre -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource DARKPrimary}">
                <TextBlock Text="V" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource DARKPrimaryText}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" Text="{ll:Str Paramètres}" />
        </StackPanel>
        <Grid Grid.Column="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0">
                <Border CornerRadius="7" Padding="2" Background="{DynamicResource VMaxCard}" BorderBrush="{DynamicResource VMaxStroke}"
                        BorderThickness="1" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbBasic" GroupName="mode" Style="{StaticResource VMaxSegment}"
                                Content="{ll:Str Essentiel}" Checked="Mode_Checked"
                                ToolTip="{ll:Str Les réglages les plus utiles}" />
                        <RadioButton x:Name="RbAdvanced" GroupName="mode" Style="{StaticResource VMaxSegment}"
                                Content="{ll:Str Avancé}" Checked="Mode_Checked"
                                ToolTip="{ll:Str 'Tous les réglages y compris les plus techniques'}" />
                    </StackPanel>
                </Border>
                <TextBox x:Name="TbSearch" Width="260" Margin="12,0,0,0" Style="{StaticResource VMaxTextBox}"
                        Tag="{ll:Str 'Rechercher un réglage (Ctrl+F)'}" TextChanged="TbSearch_TextChanged"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource VMaxCaptionButton}" Content="&#xE921;" Click="Minimize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{ll:Str Réduire}" />
                <Button Style="{StaticResource VMaxCaptionButton}" Content="&#xE8BB;" Tag="close" Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{ll:Str Fermer}" />
            </StackPanel>
        </Grid>

        <!-- Bandeau « redémarrage requis » -->
        <Border x:Name="RestartBar" Grid.Row="1" Grid.ColumnSpan="2" Margin="16,0,16,8" Padding="14,8" CornerRadius="8"
                Background="{DynamicResource VMaxNavSelected}" BorderBrush="{DynamicResource DARKPrimary}" BorderThickness="1"
                Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource VMaxAccentButton}" Content="{ll:Str Redémarrer V-Max}"
                        Click="Restart_Click" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0">
                    <Run FontFamily="{StaticResource VMaxIconFont}" Text="&#xE946;" />
                    <Run Text="{ll:Str 'Certains changements prendront effet au prochain démarrage.'}" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Navigation -->
        <DockPanel Grid.Row="2" Margin="10,4,6,12">
            <ListBox x:Name="NavList" Style="{StaticResource VMaxNavList}" SelectionChanged="NavList_SelectionChanged" />
        </DockPanel>

        <!-- Contenu -->
        <ScrollViewer x:Name="ContentScroll" Grid.Row="2" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,16" Focusable="False">
            <StackPanel x:Name="ContentHost" Margin="8,0,8,0" RenderTransformOrigin="0.5,0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ContentMove" />
                </StackPanel.RenderTransform>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
